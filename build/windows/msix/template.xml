<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="marmot"
        Arguments=""
        InstallLocation="C:\Program Files\Marmot\Marmot">
    </Installer>
    <PackageInformation
        PackageName="Marmot"
        PackageDisplayName="Marmot"
        PublisherName="CN=Marmot"
        PublisherDisplayName="Marmot"
        Version="0.1.0.0"
        PackageDescription="macOS disk space analysis">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.marmot.disk"
                Description="macOS disk space analysis"
                DisplayName="Marmot"
                ExecutableName="marmot"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Marmot</DisplayName>
            <PublisherDisplayName>Marmot</PublisherDisplayName>
            <Description>macOS disk space analysis</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="marmot.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
